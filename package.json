{
  "name": "cardpilot",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/src/index.ts",
    "start": "tsx server/src/index.ts",
    "test": "tsx --test server/test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx server/src/migrate.ts",
    "source:approve": "tsx server/src/review-source.ts",
    "format": "prettier --write \"server/**/*.ts\" \"*.json\" \"*.yaml\" \".github/**/*.yml\""
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.6.2",
    "jose": "^6.1.0",
    "luxon": "^3.7.2",
    "pg": "^8.16.3",
    "plaid": "^51.0.0",
    "undici": "^7.30.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
