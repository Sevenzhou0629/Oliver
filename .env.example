MODE=mock
PORT=3000
DATABASE_URL=postgres://cardpilot:localonly@localhost:5432/cardpilot
# Required in provider mode; mock bearer tokens are disabled there
JWT_ISSUER=
JWT_AUDIENCE=
JWKS_URL=
PLAID_CLIENT_ID=
PLAID_SECRET=
# 64 hex characters, generate with openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
BRAVE_SEARCH_API_KEY=
# Public sources remain disabled until access policy is reviewed per URL
# Sandbox OAuth requires a registered HTTPS Universal Link and associated domain
PLAID_REDIRECT_URI=
# Public HTTPS endpoint forwarding exact raw body to /api/plaid/webhook
PLAID_WEBHOOK_URL=
